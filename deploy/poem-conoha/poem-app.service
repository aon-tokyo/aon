[Unit]
Description=Poem Application Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=poemapp
Group=poemapp
WorkingDirectory=/opt/poem-app
EnvironmentFile=__APP_ENV_FILE__
ExecStart=__APP_EXEC__
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/poem-app

[Install]
WantedBy=multi-user.target
