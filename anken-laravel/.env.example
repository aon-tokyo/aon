# ══════════════════════════════════════════════════════════════════
# 案件ボード（Laravel版）環境設定テンプレート
# ══════════════════════════════════════════════════════════════════
#
# 使い方:
#   cp .env.example .env
#   php artisan key:generate
#
# ロリポップ！ハイスピード / スタンダードプランへのデプロイ手順:
#
#   1. SSH接続を有効化（ユーザー専用ページ → サーバーの管理・設定 → SSH）
#   2. ターミナルで接続:
#        ssh ロリポップアカウント@ssh.lolipop.jp -p 2222
#   3. Composerをインストール（未導入の場合）:
#        /usr/local/php/8.3/bin/php -r "eval('?>'.file_get_contents('https://getcomposer.org/installer'));"
#        export PATH="$PATH:/usr/local/php/8.3/bin"
#   4. プロジェクトをサーバーへ配置（例: ~/anken-laravel/）:
#        git clone <リポジトリURL> ~/anken-laravel
#        cd ~/anken-laravel
#        composer install --no-dev --optimize-autoloader
#   5. .envを作成して設定:
#        cp .env.example .env
#        php artisan key:generate
#   6. 公開ディレクトリのシンボリックリンクを設定:
#        ln -s ~/anken-laravel/public ~/web/aruaru/public
#      → ロリポップ！管理画面でドメインの公開フォルダを "aruaru/public" に設定
#   7. パーミッション変更:
#        chmod -R 777 storage bootstrap/cache
#   8. ブラウザで https://あなたのドメイン/ にアクセスして確認
#
# ※ DB不要モード: 案件データはコード内のサンプルを使用するため
#   SESSION_DRIVER=file / CACHE_STORE=file に設定すれば DB 不要で動作します。
# ══════════════════════════════════════════════════════════════════

APP_NAME="案件ボード"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# 本番ドメインに合わせて変更してください
# 例: APP_URL=https://audiocafe.tokyo
APP_URL=https://your-domain.example.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ──────────────────────────────────────────────────────────────────
# データベース設定（ロリポップ！MySQL）
# ──────────────────────────────────────────────────────────────────
# ロリポップ！管理画面 → データベース → MySQL でホスト・DB名・ユーザー・PW を確認
DB_CONNECTION=mysql
DB_HOST=mysql○○.lolipop.jp
DB_PORT=3306
DB_DATABASE=ロリポップユーザー名_DB名
DB_USERNAME=ロリポップユーザー名
DB_PASSWORD=DBパスワード

# ──────────────────────────────────────────────────────────────────
# セッション・キャッシュ（DBレスでも動かしたい場合は file に変更）
# ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# ──────────────────────────────────────────────────────────────────
# Google Custom Search（マッチング結果のWeb検索・純粋PHP版と同じキー）
# ──────────────────────────────────────────────────────────────────
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ──────────────────────────────────────────────────────────────────
# メール設定（お問い合わせ機能追加時に設定）
# ──────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.lolipop.jp
MAIL_PORT=587
MAIL_USERNAME=your@your-domain.example.com
MAIL_PASSWORD=メールパスワード
MAIL_FROM_ADDRESS="your@your-domain.example.com"
MAIL_FROM_NAME="${APP_NAME}"
