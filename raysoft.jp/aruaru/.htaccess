# ============================================================
# 案件ボード — API キー設定ファイル
# ============================================================
#
# ★ このファイルの使い方
#   1. 下の SetEnv の行に各APIキーの値を入力してください
#   2. FTPで aruaru/.htaccess としてアップロードしてください
#   3. このファイルは絶対に GitHub にアップしないでください
#
# ★ 外部からこのファイルの中身を見られないようにする設定も
#   下部に含まれています（ロリポップ！対応済み）
#
# ============================================================

# ── Google Custom Search API ─────────────────────────────────
# 取得先: https://console.cloud.google.com/ → 認証情報 → APIキー作成
# 形式: AIzaSy... で始まる文字列
SetEnv GOOGLE_CSE_KEY "ここに AIzaSy... で始まるAPIキーを入力"

# 取得先: https://programmablesearchengine.google.com/
# 形式: 数字:英字 の組み合わせ（例: 017576662512468239146:omuauf_lfve）
SetEnv GOOGLE_CSE_CX  "ここに検索エンジンIDを入力"

# ── OpenAI API ───────────────────────────────────────────────
# 取得先: https://platform.openai.com/api-keys → Create new secret key
# 形式: sk-proj-... または sk-... で始まる文字列
SetEnv OPENAI_API_KEY "ここに sk-proj-... で始まるAPIキーを入力"

# ============================================================
# セキュリティ設定：.htaccess 自体を外部から読めないようにする
# ============================================================
<Files ".htaccess">
    Require all denied
</Files>

# ============================================================
# セキュリティ設定：data/ フォルダのJSONキャッシュを外部から読めないようにする
# ============================================================
<FilesMatch "\.json$">
    Require all denied
</FilesMatch>

# ============================================================
# PHP エラー表示を本番用に無効化（セキュリティ対策）
# ============================================================
php_flag display_errors off
php_flag log_errors on
